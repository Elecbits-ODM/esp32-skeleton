# Minimal sdkconfig defaults for the eb_network wifi_connect_demo example.

# WiFi
CONFIG_ESP32_WIFI_NVS_ENABLED=y

# Bluetooth (Bluedroid, BLE only) — required by eb_ble_prov
CONFIG_BT_ENABLED=y
CONFIG_BT_CONTROLLER_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_BLE_ENABLED=y
CONFIG_BT_GATTS_ENABLE=y
CONFIG_BT_CLASSIC_ENABLED=n
# eb_ble_prov uses the legacy (BLE 4.2) advertising API (esp_ble_gap_start_advertising
# / esp_ble_gap_config_adv_data / esp_ble_gap_stop_advertising), which is compiled out
# unless these are explicitly enabled:
CONFIG_BT_BLE_42_FEATURES_SUPPORTED=y
CONFIG_BT_BLE_42_ADV_EN=y
CONFIG_BT_BLE_42_SCAN_EN=y

# Partition table needs an NVS partition sized for WiFi + provisioning data.
# The Bluedroid BLE stack makes the app binary too big for the default 1MB
# single-app slot, so use the larger (2MB) single-app table instead.
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
