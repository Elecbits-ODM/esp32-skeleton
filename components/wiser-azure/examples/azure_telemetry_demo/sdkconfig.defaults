# Minimal example config for the eb_azure telemetry demo.
# Fill in real values via `idf.py menuconfig` -> "EB Azure IoT Configuration"
# before building against a real Azure DPS/IoT Hub instance.

CONFIG_EB_AZURE_DPS_ID_SCOPE="0ne00XXXXXXX"
CONFIG_EB_AZURE_DPS_REG_ID_PREFIX=""
CONFIG_EB_AZURE_TELEMETRY_INTERVAL_SEC=60

# Task watchdog must be enabled; eb_azure_iot resets it from its own task.
CONFIG_ESP_TASK_WDT_INIT=y

# eb_azure depends on eb_network, whose eb_ble_prov.c requires the Bluedroid
# BLE stack (including the legacy BLE 4.2 advertising API) to be enabled —
# see eb_network's own example sdkconfig.defaults for details.
CONFIG_ESP32_WIFI_NVS_ENABLED=y
CONFIG_BT_ENABLED=y
CONFIG_BT_CONTROLLER_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_BLE_ENABLED=y
CONFIG_BT_GATTS_ENABLE=y
CONFIG_BT_CLASSIC_ENABLED=n
CONFIG_BT_BLE_42_FEATURES_SUPPORTED=y
CONFIG_BT_BLE_42_ADV_EN=y
CONFIG_BT_BLE_42_SCAN_EN=y

# The Bluedroid BLE stack + Azure SDK/TLS make the app binary too big for the
# default 1MB single-app partition slot, so use the larger (2MB) table.
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
